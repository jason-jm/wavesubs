<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mac App Store 版：沙盒强制开启。与 Developer ID 版（entitlements.mac.plist）的差别：
       不能再用 disable-library-validation / dyld 环境变量，换成一组明确的沙盒权限。 -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- Electron 的 V8 需要 JIT -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- 云端翻译接口、Hugging Face 模型下载 -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- 本地 llama-server 监听 127.0.0.1，子进程继承沙盒，监听权限必须挂在主应用上 -->
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- 用户拖入/选择的视频与字幕文件（含所在文件夹，若拖的是文件夹） -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- 无法写回视频旁边时的兜底输出位置 ~/Movies/Wave Subs -->
  <key>com.apple.security.assets.movies.read-write</key>
  <true/>
  <!-- 记住用户选过的输出文件夹（security-scoped bookmark） -->
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <!-- Electron 多进程共享容器所需 -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>TZ7V6PMGV6.com.wavesubs.desktop</string>
  </array>
</dict>
</plist>
